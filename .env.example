# Dual market TESTING setup (safe — fake money both sides)
# Prices still come from LIVE Alpaca + Angel One APIs

US_ENABLED=true
ALPACA_PAPER=true
ALPACA_API_KEY=your_alpaca_paper_key
ALPACA_SECRET_KEY=your_alpaca_paper_secret
BASE_URL=https://paper-api.alpaca.markets

ANGEL_API_KEY=your_angel_api_key
ANGEL_CLIENT_ID=your_client_id
ANGEL_PIN=your_mpin
ANGEL_TOTP_SECRET=your_totp_secret

# Angel One has NO official paper account — we simulate fake INR
# using live NSE quotes. Set false + LIVE_* only after strategy proves itself.
INDIA_PAPER=true
INDIA_PAPER_STARTING_CASH=100000

LIVE_TRADING=false
LIVE_CONFIRM=

MAX_POSITION_PCT=0.05
MAX_SHARES_PER_ORDER=100
