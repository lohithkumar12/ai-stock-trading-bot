# =============================================================================
# India-first TESTING setup (SAFE DEFAULTS — fake INR; live NSE quotes)
# =============================================================================

# --- India broker: dhan (default) | angel ---
INDIA_BROKER=dhan

# DhanHQ (preferred)
# Access token lasts ~24h. Prefer PIN + TOTP so the bot can auto-refresh.
# API key/secret are optional for PIN/TOTP login (kept for OAuth / console apps).
# Live orders may require your VM public IP whitelisted in Dhan API settings.
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token
DHAN_PIN=your_dhan_pin
DHAN_TOTP_SECRET=your_dhan_totp_secret
DHAN_API_KEY=your_dhan_api_key
DHAN_API_SECRET=your_dhan_api_secret

# Angel One (optional fallback — set INDIA_BROKER=angel)
# ANGEL_API_KEY=your_angel_api_key
# ANGEL_CLIENT_ID=your_client_id
# ANGEL_PIN=your_mpin
# ANGEL_TOTP_SECRET=your_totp_secret

# Paper sim: live NSE data, fake INR (no real orders)
INDIA_PAPER=true
INDIA_PAPER_STARTING_CASH=100000

# Real INR orders ONLY when BOTH are set (keep OFF for testing):
LIVE_TRADING=false
LIVE_CONFIRM=

# =============================================================================
# Strategy (same engine for US + India; params can differ per market)
#   trend_pullback   = PRIMARY (default) — best in Dec23–Dec25 daily backtest
#   mean_reversion   = BB+RSI only when ADX shows ranging market
#   regime_adaptive  = ADX switches between trend / mean-reversion
# =============================================================================
STRATEGY_NAME=trend_pullback
USE_RELATIVE_STRENGTH=true
RS_TOP_N=5
RS_LOOKBACK_BARS=60
CONFIRM_BARS=2
TIMEFRAME=1Hour
LOOKBACK_BARS=250

# Shared indicator defaults
SMA_SLOW=200
SMA_FAST=20
EMA_PULLBACK=21
RSI_PERIOD=14
RSI_BUY_THRESHOLD=35
RSI_SELL_THRESHOLD=65
BB_STD_DEV=2.0
ATR_PERIOD=14
ADX_PERIOD=14
ADX_RANGE_MAX=25
VOLUME_AVG_PERIOD=20
STRICT_SELL=true

# Extra filters / execution safety
USE_MTF_FILTER=true
USE_REGIME_FILTER=true
SYNC_BROKER_STOPS=true
REGIME_SYMBOL_INDIA=RELIANCE

# Optional alerts
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=

# Backtest realism
BT_COMMISSION_PCT=0.001
BT_SLIPPAGE_PCT=0.0005

# Optional per-market overrides (fall back to shared values above)
# INDIA_SMA_SLOW=200
# INDIA_RSI_BUY=35
# INDIA_ADX_RANGE_MAX=25

# =============================================================================
# Risk — minimize loss (ATR sizing + R targets + book caps)
# =============================================================================
RISK_PER_TRADE=0.0075
MAX_POSITION_PCT=0.05
ATR_STOP_MULT=2.0
ATR_TRAIL_MULT=2.0
TAKE_PROFIT_R=2.5
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
DAILY_DRAWDOWN_LIMIT=0.03
MAX_SHARES_PER_ORDER=100
MAX_OPEN_POSITIONS=4
MAX_CLUSTER_POSITIONS=2

# Skip first/last N minutes of the session (set ALLOW_OPEN_CLOSE_WINDOW=true to disable)
AVOID_OPEN_MINUTES=15
AVOID_CLOSE_MINUTES=15
ALLOW_OPEN_CLOSE_WINDOW=false

# Entries stay LIMIT brackets unless you explicitly allow market (still prefer limit)
ALLOW_MARKET_ENTRIES=false

# Trade journal SQLite path
TRADE_JOURNAL_PATH=trade_journal.db

# Loop cadence (seconds)
INDIA_LOOP_INTERVAL_SEC=300

# =============================================================================
# US Market — Dhan Global Stocks (USD)
# =============================================================================
# Uses the same DHAN_* credentials as India above.
# Ensure Global Stocks is activated on your Dhan account (dhan.co -> Settings).

# Paper sim: live US stock data, fake USD (no real global orders)
US_PAPER=true
US_PAPER_STARTING_CASH=10000

# Real USD orders ONLY when BOTH are set (keep OFF for testing):
# US_LIVE_TRADING=true
# US_LIVE_CONFIRM=YES_REAL_MONEY

# US Universe & Loop interval
US_STOCK_UNIVERSE=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,JPM,V,UNH
US_LOOP_INTERVAL_SEC=300

# =============================================================================
# Dhan Expansion Flags (Paid Feed, F&O, MCX, Currency, Product Types)
# =============================================================================

# Paid Market Data Feed (WebSocket tick streaming - avoids HTTP 429 rate limits)
DHAN_LIVE_WEBSOCKET=true

# Product Type for India Equities: CNC (Delivery) | INTRADAY (MIS) | MTF (Margin Trading)
INDIA_PRODUCT_TYPE=CNC

# --- Segment 1: India F&O (NSE Index & Stock Futures/Options) ---
INDIA_FNO_ENABLED=true
INDIA_FNO_PAPER=true
INDIA_FNO_PAPER_STARTING_CASH=200000
INDIA_FNO_LIVE_TRADING=false
INDIA_FNO_LIVE_CONFIRM=
INDIA_FNO_UNIVERSE=NIFTY,BANKNIFTY,FINNIFTY
INDIA_FNO_MAX_LOTS=2
INDIA_FNO_STRATEGY=directional_options
INDIA_FNO_CAPITAL_CAP=200000

# --- Segment 2: MCX Commodities (Gold, Silver, Crude Oil, Natural Gas) ---
# Active hours: Mon-Fri 09:00 AM – 11:30 PM IST (Overlaps US session!)
# Do NOT arm live until paper is stable. Live needs MCX entitlement on Dhan account.
MCX_ENABLED=true
MCX_PAPER=true
MCX_PAPER_STARTING_CASH=500000
MCX_LIVE_TRADING=false
MCX_LIVE_CONFIRM=
MCX_UNIVERSE=CRUDEOIL,GOLD,SILVER,NATURALGAS
MCX_CAPITAL_CAP=500000

# --- Segment 3: Currency Derivatives (NSE USDINR) ---
# Active hours: Mon-Fri 09:00 AM – 05:00 PM IST
CURRENCY_ENABLED=true
CURRENCY_PAPER=true
CURRENCY_PAPER_STARTING_CASH=100000
CURRENCY_LIVE_TRADING=false
CURRENCY_LIVE_CONFIRM=
CURRENCY_UNIVERSE=USDINR
CURRENCY_CAPITAL_CAP=100000

